# Banco (Neon) — connection string do painel do Neon
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-1.aws.neon.tech/cracha?sslmode=require

# String aleatória longa (ex.: openssl rand -hex 32)
SESSION_SECRET=

# Primeiro administrador (criado na 1ª inicialização, se não houver nenhum)
ADMIN_NAME=Seu Nome
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=

# Subpasta onde o sistema roda (ex.: /cracha -> https://cedcci.com.br/cracha). Vazio = raiz
BASE_PATH=/cracha

APP_NAME=Estúdio de Crachás
